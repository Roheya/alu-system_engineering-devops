#!/usr/bin/env bash
# Install and configure HAProxy with round robin load balancing

apt-get -y update
apt-get -y install haproxy

cat > /etc/haproxy/haproxy.cfg <<EOF
global
    log /dev/log local0
    log /dev/log local1 notice
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend webservers

backend webservers
    balance roundrobin
    server web-01 18.132.38.113:80 check
    server web-02 3.10.140.1:80 check
EOF

service haproxy restart
systemctl enable haproxy
