#!/usr/bin/env bash
# Configure HAProxy as a load balancer
set -e

# Update package lists and install HAProxy
apt-get update
apt-get install -y haproxy

# Configure HAProxy
cat > /etc/haproxy/haproxy.cfg <<'EOF'
global
    daemon
    maxconn 256

defaults
    mode http
    timeout connect 5000ms
    timeout client 50000ms
    timeout server 50000ms

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    # Backend servers: 7413-web-01 and 7413-web-02
    server web-01 18.132.38.113:80 check
    server web-02 3.10.140.1:80 check
EOF

# Validate HAProxy configuration
haproxy -c -f /etc/haproxy/haproxy.cfg

# Enable HAProxy at startup
systemctl enable haproxy

# Restart HAProxy using its init service
service haproxy restart

# Display configured backend servers
echo "Configured backend: web-01"
echo "Configured backend: web-02"
