
#!/usr/bin/env bash
# Configures a new Ubuntu machine with HAProxy as a load balancer
set -e

# Update package lists
apt-get update

# Install HAProxy
apt-get install -y haproxy

# Back up the default configuration if it exists
if [ -f /etc/haproxy/haproxy.cfg ] && [ ! -f /etc/haproxy/haproxy.cfg.bak ]; then
    cp /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.bak
fi

# Configure HAProxy
cat > /etc/haproxy/haproxy.cfg <<'EOF'
global
    daemon
    maxconn 256

defaults
    mode http
    timeout connect 5000ms
    timeout client 50000ms
    timeout server 50000ms

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    # Backend hosts: 7413-web-01 and 7413-web-02
    server web-01 18.132.38.113:80 check
    server web-02 3.10.140.1:80 check
# Validate HAProxy configuration
haproxy -c -f /etc/haproxy/haproxy.cfg

# Enable HAProxy at startup
systemctl enable haproxy

# Restart HAProxy
service haproxy restart

# Enable HAProxy at startup
systemctl enable haproxy

# Restart HAProxy
service haproxy restart

# Display configured backend servers
echo "Configured backend: web-01"
echo "Configured backend: web-02"
