
#!/usr/bin/env bash
# Install and configure HAProxy as a round-robin load balancer

set -e

# Require root privileges
if [ "$EUID" -ne 0 ]; then
    echo "Please run this script with sudo."
    exit 1
fi

# Update package lists and install HAProxy
apt-get update -y
DEBIAN_FRONTEND=noninteractive apt-get install -y haproxy

# Configure backend hostnames and aliases
sed -i -E '/[[:space:]](7413-web-01|7413-web-02|web-01|web-02)([[:space:]]|$)/d' /etc/hosts

printf "10.30.21.18 7413-web-01 web-01\n10.30.10.21 7413-web-02 web-02\n" >> /etc/hosts

# Configure HAProxy
cat > /etc/haproxy/haproxy.cfg <<'EOF'
global
    daemon
    maxconn 256

defaults
    mode http
    timeout connect 5000ms
    timeout client 50000ms
    timeout server 50000ms

frontend http_front
    bind *:80
    default_backend web_backend

backend web_backend
    balance roundrobin
    server web-01 7413-web-01:80 check
    server web-02 7413-web-02:80 check
EOF

# Validate HAProxy configuration
haproxy -c -f /etc/haproxy/haproxy.cfg

# Enable HAProxy at startup and manage it through its service interface
systemctl enable haproxy
service haproxy restart

# Display backend hostname resolution
getent hosts 7413-web-01 7413-web-02
getent hosts web-01 web-02

